# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Your Discord user ID. Only this user can use /adjust and /setup.
OWNER_ID=322189913711968256

# Optional: uptime monitor check-in URL (e.g. https://hc-ping.com/<uuid> from healthchecks.io).
# The bot pings it every few minutes while healthy; you get an email if the pings stop.
HEALTHCHECK_URL=
